<view class="page-shell">
  <view class="hero">
    <view class="hero-copy">
      <text class="hero-kicker">{{dateText}}</text>
      <text class="hero-title">{{loading ? '正在加载课程安排…' : error ? '课程安排暂时不可用' : count === 0 ? '今天没有课，祝你开心～' : '今天有 ' + count + ' 节课，一切顺利～'}}</text>
    </view>
    <image class="hero-logo" src="/rabbit-logo.png" mode="aspectFit" />
  </view>

  <view wx:if="{{error}}" class="empty card"><text>{{error}}</text><button class="plain-button" bindtap="loadSessions">重试</button></view>
  <block wx:if="{{!loading && !error}}">
  <view class="section-heading"><text class="section-title">今日课程</text></view>
  <view wx:if="{{today.length === 0}}" class="empty card">今天还没有课程安排</view>
  <view wx:for="{{today}}" wx:key="id" class="class-card card {{item.status === 'cancelled' ? 'cancelled' : ''}}" data-id="{{item.id}}" bindtap="openDetail">
    <view class="time-rail"><text class="time-main">{{item.start}}</text><text class="time-end">{{item.end}}</text></view>
    <view class="class-main">
      <view class="class-top"><text class="class-name">{{item.title}}</text><text wx:if="{{item.status !== 'scheduled'}}" class="status status-{{item.status}}">{{item.statusLabel}}</text></view>
      <text class="student-name">{{item.studentNames}}</text>
      <text wx:if="{{item.note}}" class="note-preview">{{item.note}}</text>
    </view>
    <text class="chevron">›</text>
  </view>

  <view class="section-heading upcoming-heading"><text class="section-title">接下来的课程</text></view>
  <view wx:for="{{upcoming}}" wx:key="id" class="upcoming-card card {{item.status === 'cancelled' ? 'cancelled' : ''}}" data-id="{{item.id}}" bindtap="openDetail">
    <view class="upcoming-date"><text>{{item.dateLabel}}</text><text class="upcoming-weekday">{{item.start}}</text></view>
    <view class="upcoming-info"><view class="class-top"><text class="class-name">{{item.studentNames}}</text><text wx:if="{{item.status !== 'scheduled'}}" class="status status-{{item.status}}">{{item.statusLabel}}</text></view><text class="upcoming-course">{{item.title}} · {{item.timeLabel}}</text></view>
    <text class="chevron">›</text>
  </view>
  <view wx:if="{{upcoming.length === 0}}" class="empty card">暂时没有后续课程安排</view>
  </block>
</view>
<tab-bar active="today" />

<bottom-sheet visible="{{onboardingStep === 'course'}}" title="添加课程" bind:close="closeOnboarding">
  <view class="onboarding-fields">
    <text class="onboarding-hint">先添加你教的课程，再开始安排学员和课次。</text>
    <text class="onboarding-label">课程名称</text>
    <input class="onboarding-input" value="{{courseName}}" placeholder="输入课程名称" maxlength="40" bindinput="onCourseNameInput" />
    <text wx:if="{{courseNameError}}" class="onboarding-error">{{courseNameError}}</text>
    <text class="onboarding-label onboarding-field-gap">课程介绍（选填）</text>
    <textarea class="onboarding-textarea" value="{{courseDescription}}" placeholder="简单介绍这门课程" maxlength="500" bindinput="onCourseDescriptionInput" />
    <text wx:if="{{courseSaveError}}" class="onboarding-error">{{courseSaveError}}</text>
    <button class="primary-button onboarding-primary" loading="{{onboardingSaving}}" disabled="{{onboardingSaving}}" bindtap="saveOnboardingCourse">添加课程</button>
  </view>
</bottom-sheet>

<bottom-sheet visible="{{onboardingStep === 'student'}}" title="添加第一位学员" bind:close="closeOnboarding">
  <view class="onboarding-fields">
    <text class="onboarding-hint">课程已创建，接下来添加一位学员。</text>
    <text class="onboarding-label">姓名</text>
    <input class="onboarding-input" value="{{studentName}}" placeholder="输入学员姓名" maxlength="40" bindinput="onStudentNameInput" />
    <text wx:if="{{studentNameError}}" class="onboarding-error">{{studentNameError}}</text>
    <text class="onboarding-label onboarding-field-gap">课程</text>
    <view class="onboarding-course">{{onboardingCourseName}}</view>
    <text class="onboarding-label onboarding-field-gap">备注（选填）</text>
    <textarea class="onboarding-textarea" value="{{studentNotes}}" placeholder="添加学员备注" maxlength="200" bindinput="onStudentNotesInput" />
    <text wx:if="{{studentSaveError}}" class="onboarding-error">{{studentSaveError}}</text>
    <button class="primary-button onboarding-primary" loading="{{onboardingSaving}}" disabled="{{onboardingSaving}}" bindtap="saveOnboardingStudent">创建学员</button>
  </view>
</bottom-sheet>
