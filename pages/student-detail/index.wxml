<view wx:if="{{loading}}" class="detail-state">正在加载学员资料…</view>
<view wx:elif="{{loadError}}" class="detail-state"><text>{{loadError}}</text><button class="plain-button" bindtap="refresh">重试</button></view>

<view wx:if="{{student && !loading}}" class="page-shell student-detail-page">
  <view class="student-profile card">
    <view class="profile-title-row"><text class="profile-title">{{student.name}}</text><text class="edit-link" bindtap="openEdit">编辑</text></view>
    <view class="profile-row"><text class="profile-label">课程</text><text class="profile-value course-value">{{student.className}}</text></view>
    <view class="profile-row"><text class="profile-label">开始于</text><text class="profile-value">{{student.startedLabel}}</text></view>
    <view class="profile-row notes-row"><text class="profile-label">备注</text><text class="profile-value">{{student.notes || '暂无备注'}}</text></view>
  </view>

  <view class="credits-section">
    <view class="section-heading"><text class="section-title">课时</text></view>
    <view class="credits-card card">
      <view class="credits-summary"><text class="credits-number">{{student.remainingCredits}} 次剩余</text><text class="credits-total">{{student.remainingCredits}}/{{student.totalCredits}}</text></view>
      <view class="progress-track"><view class="progress-value" style="width:{{creditProgress}}%"></view></view>
    </view>
    <view class="section-links credits-links"><text class="edit-link" data-sheet="creditHistory" bindtap="openSheet">课时记录 →</text></view>
  </view>

  <view class="upcoming-section">
    <view class="section-heading"><text class="section-title">即将上课</text></view>
    <view class="upcoming-cell card">
      <view wx:if="{{upcoming.length === 0}}" class="empty-card">暂时没有预约课程</view>
      <view wx:for="{{upcoming}}" wx:key="id" class="upcoming-class" data-id="{{item.id}}" bindtap="openClass">
        <view class="upcoming-class-time"><text>{{item.dateLabel}}</text><text class="muted">{{item.timeLabel}}</text></view>
        <text class="upcoming-class-name">{{item.title}}</text><text wx:if="{{source === 'local'}}" class="arrow">›</text>
      </view>
    </view>
    <view class="section-links upcoming-links"><text class="edit-link" data-sheet="appointmentHistory" bindtap="openSheet">预约记录 →</text></view>
  </view>
</view>

<view wx:if="{{student && !loading}}" class="student-action-dock">
  <button class="secondary-button" data-sheet="credits" bindtap="openSheet">添加课时</button>
  <button class="primary-button" data-sheet="appointment" bindtap="openSheet">添加预约</button>
</view>

<bottom-sheet visible="{{sheet !== ''}}" title="{{sheetTitle}}" bind:close="closeSheet">
    <view wx:if="{{sheet === 'credits'}}" class="sheet-fields">
      <text class="input-label">添加课时次数</text><input class="sheet-input" type="number" placeholder="输入课时数量" value="{{creditAmount}}" bindinput="onCreditAmount" />
      <text class="input-label field-gap">费用</text><input class="sheet-input" type="digit" placeholder="输入费用（选填）" value="{{fee}}" bindinput="onFee" />
      <text class="input-label field-gap">备注（选填）</text><textarea class="sheet-textarea" placeholder="添加课时备注" value="{{creditNotes}}" maxlength="200" bindinput="onCreditNotes" />
      <button class="primary-button sheet-primary" loading="{{savingAction}}" disabled="{{savingAction}}" bindtap="confirmCredits">确认添加</button>
    </view>

    <view wx:elif="{{sheet === 'appointment'}}" class="sheet-fields">
      <text class="input-label">预约日期</text>
      <picker mode="date" value="{{appointmentDate}}" start="{{minDate}}" bindchange="onAppointmentDate"><view class="picker-field"><text>日期</text><view class="picker-value">{{appointmentDate}}<image class="picker-chevron" src="/assets/chevron-down.svg" mode="aspectFit" /></view></view></picker>
      <text class="input-label field-gap">上课时间</text>
      <view class="appointment-time-fields">
        <picker class="time-picker" mode="time" value="{{appointmentStart}}" bindchange="onAppointmentStart"><view class="picker-field"><text>开始</text><view class="picker-value">{{appointmentStart}}<image class="picker-chevron" src="/assets/chevron-down.svg" mode="aspectFit" /></view></view></picker>
        <picker class="time-picker" mode="time" value="{{appointmentEnd}}" bindchange="onAppointmentEnd"><view class="picker-field"><text>结束</text><view class="picker-value"><text wx:if="{{appointmentEndIsNextDay}}" class="next-day-label">次日</text>{{appointmentEnd}}<image class="picker-chevron" src="/assets/chevron-down.svg" mode="aspectFit" /></view></view></picker>
      </view>
      <text class="input-label field-gap">备注（选填）</text><textarea class="sheet-textarea" placeholder="添加预约备注" value="{{appointmentNotes}}" maxlength="200" bindinput="onAppointmentNotes" />
      <button class="primary-button sheet-primary" loading="{{savingAction}}" disabled="{{savingAction}}" bindtap="confirmAppointment">确认预约</button>
    </view>

    <view wx:else class="history-list">
      <view wx:if="{{historyItems.length === 0}}" class="history-empty">暂无记录</view>
      <view wx:for="{{historyItems}}" wx:key="id" class="history-item">
        <view class="history-dot"></view>
        <view class="history-copy"><text class="history-title">{{item.title}}</text><text class="history-detail">{{item.detail}}</text><text class="history-time">{{item.time}}</text><text wx:if="{{item.note}}" class="history-note">备注：{{item.note}}</text></view>
      </view>
    </view>
</bottom-sheet>
