<view class="page-shell my-classes-page">
  <view wx:for="{{offerings}}" wx:key="id" class="offering-card card" data-id="{{item.id}}" bindtap="editClass">
    <view class="offering-head"><text class="offering-name">{{item.name}}</text></view>
    <text class="offering-description {{item.description ? '' : 'empty-description'}}">{{item.description || '暂无课程介绍'}}</text>
    <view class="offering-footer" data-id="{{item.id}}" catchtap="openRoster"><text class="action-link">{{item.studentCount}} 位学员 →</text></view>
  </view>
  <view class="add-class-card" bindtap="addClass"><image src="/assets/plus.svg" mode="aspectFit" /><text>添加课程</text></view>
</view>

<bottom-sheet visible="{{rosterOpen}}" title="{{rosterTitle}}" max-height="78vh" bind:close="closeRoster">
    <view wx:if="{{roster.length === 0}}" class="roster-empty">这门课程还没有学员</view>
    <view wx:for="{{roster}}" wx:key="id" class="roster-row" data-id="{{item.id}}" bindtap="openStudent">
      <view class="roster-avatar" style="background:{{item.color}}">{{item.initial}}</view><text class="roster-name">{{item.name}}</text><text class="roster-chevron">›</text>
    </view>
</bottom-sheet>
