.detail-page { padding-bottom: 310rpx; }
.detail-head { display:flex; flex-direction:column; padding:16rpx 8rpx 32rpx; }
.detail-title-row { display:flex; align-items:center; gap:16rpx; margin-top:16rpx; }
.detail-title { flex:1; min-width:0; font-size:var(--font-size-h1); font-weight:760; letter-spacing:.3rpx; }
.status-row { display:flex; align-items:center; margin-top:12rpx; }
.status-badge { font-size:var(--font-size-small); padding:9rpx 19rpx; border-radius:100rpx; font-weight:650; }
.status-scheduled { background:var(--color-brand-soft); color:var(--color-brand); }
.status-cancelled { background:var(--color-status-cancelled-background); color:var(--color-status-cancelled); }
.status-completed { background:var(--color-brand-soft); color:var(--color-brand); }
.credit-hint { color:var(--color-text-weak); font-size:var(--font-size-small); }
.summary-card { display:flex; align-items:center; padding:33rpx; margin-bottom:22rpx; background:var(--color-surface); }
.summary-icon { display:flex; align-items:center; justify-content:center; width:86rpx; height:86rpx; border-radius:26rpx; background:var(--color-surface-muted); color:var(--color-text); font-size:var(--font-size-h1); margin-right:24rpx; }
.calendar-icon { width:42rpx; height:42rpx; }
.summary-text { display:flex; flex-direction:column; gap:6rpx; }
.summary-date { color:var(--color-text-weak); font-size:var(--font-size-small); }
.summary-time { color:var(--color-text); font-size:var(--font-size-h1); font-weight:760; }
.info-card { padding:12rpx 32rpx; }
.info-row { display:flex; align-items:flex-start; padding:31rpx 0; gap:24rpx; }
.student-row { align-items:center; }
.field-label { color:var(--color-text-weak); font-size:var(--font-size-normal); min-width:95rpx; }
.field-value { color:var(--color-text); font-size:var(--font-size-normal); font-weight:700; flex:1; }
.empty-note { color:var(--color-text-weak); }
.student-value { display:flex; flex:1; align-items:center; min-width:0; }
.student-link { color:var(--color-brand); }
.student-link-hover { opacity:.68; }
.divider { height:2rpx; background:var(--color-border); }
.note-content { display:flex; flex:1; flex-direction:column; gap:22rpx; }
.edit-link { color:var(--color-brand); font-size:var(--font-size-small); font-weight:650; }
.history-section .section-heading { display:flex; justify-content:space-between; align-items:baseline; margin:45rpx 5rpx 20rpx; }
.history-card { padding:15rpx 30rpx; }
.history-entry { display:flex; gap:20rpx; padding:23rpx 0; }
.history-entry + .history-entry { border-top:2rpx solid var(--color-border); }
.history-marker { width:15rpx; height:15rpx; border-radius:50%; background:var(--color-brand); margin-top:14rpx; flex-shrink:0; box-shadow:0 0 0 7rpx var(--color-brand-soft); }
.history-content { display:flex; flex-direction:column; gap:7rpx; }
.history-title { color:var(--color-text); font-size:var(--font-size-small); font-weight:650; }
.history-time { color:var(--color-text-weak); font-size:var(--font-size-small); }
.history-note { color:var(--color-text-weak); font-size:var(--font-size-small); line-height:1.5; margin-top:4rpx; }
.action-dock { position:fixed; z-index:10; left:0; right:0; bottom:0; background:var(--color-surface); border-top:2rpx solid var(--color-border); padding:23rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); box-shadow:var(--shadow-dock); }
.action-row { display:flex; gap:18rpx; margin-top:16rpx; }
.action-row button { flex:1; margin:0; }
.sheet-fields { display:flex; flex-direction:column; }
.sheet-description { color:var(--color-text-weak); font-size:var(--font-size-normal); line-height:1.5; margin-bottom:16rpx; }
.input-label { font-size:var(--font-size-normal); color:var(--color-text-weak); font-weight:400; margin-bottom:14rpx; }
.note-label { margin-top:22rpx; }
.picker-field { display:flex; justify-content:space-between; align-items:center; background:var(--color-surface-muted); border:2rpx solid var(--color-border); border-radius:20rpx; padding:25rpx 23rpx; color:var(--color-text); font-size:var(--font-size-normal); margin-bottom:15rpx; }
.picker-label { color:var(--color-text-weak); font-size:var(--font-size-normal); }
.picker-value { display:flex; align-items:center; gap:12rpx; color:var(--color-text); font-weight:700; }
.picker-chevron { width:26rpx; height:26rpx; flex-shrink:0; }
.time-pickers { display:flex; gap:16rpx; }
.time-pickers picker { flex:1; }
.sheet-textarea { width:100%; height:135rpx; box-sizing:border-box; background:var(--color-surface-muted); border:2rpx solid var(--color-border); border-radius:20rpx; padding:20rpx; font-size:var(--font-size-normal); font-weight:700; color:var(--color-text); }
.sheet-primary { width:100%; margin:28rpx 0 0; }
.sheet-secondary { width:100%; margin:15rpx 0 0; }
