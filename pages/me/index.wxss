.account-card { display:flex; align-items:center; width:100%; min-height:142rpx; padding:27rpx; box-sizing:border-box; }
/* Override the fixed button width in WeChat's v2 default styles. */
button.account-card.account-login { display:flex; width:100%; margin:0; padding:27rpx; box-sizing:border-box; text-align:left; line-height:1.4; background:var(--color-surface); }
button.account-card.account-login[disabled] { background:var(--color-surface); }
.account-avatar { width:86rpx; height:86rpx; flex-shrink:0; margin-right:23rpx; }
.account-avatar image { display:block; width:100%; height:100%; }
.account-name { flex:1; min-width:0; font-size:var(--font-size-h2); font-weight:700; color:var(--color-text); }
.menu-chevron { color:var(--color-text-weak); font-size:var(--font-size-h1); line-height:1; }
.menu-card { margin-top:28rpx; padding:0 27rpx; }
.menu-card-first { margin-top:0; }
.menu-row { display:flex; align-items:center; justify-content:space-between; min-height:104rpx; font-size:var(--font-size-normal); font-weight:600; color:var(--color-text); }
.menu-row + .menu-row { border-top:2rpx solid var(--color-border); }
.account-copy { display:flex; flex:1; flex-direction:column; gap:8rpx; min-width:0; }
.clear-card { display:flex; flex-direction:column; gap:16rpx; margin-top:28rpx; padding:28rpx; }
.clear-title { font-size:var(--font-size-normal); font-weight:700; color:var(--color-status-cancelled); }
.clear-description { font-size:var(--font-size-small); line-height:1.5; color:var(--color-text-weak); }
button.clear-button { width:100%; height:80rpx; box-sizing:border-box; margin:4rpx 0 0; border:2rpx solid var(--color-status-cancelled); border-radius:20rpx; background:var(--color-surface); color:var(--color-status-cancelled); font-size:var(--font-size-normal); font-weight:650; }
.clear-error { color:var(--color-status-cancelled); font-size:var(--font-size-small); }
