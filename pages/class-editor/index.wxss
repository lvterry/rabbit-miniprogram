.editor-page { padding-bottom:235rpx; }
.editor-card { padding:8rpx 28rpx; }
.editor-field { display:flex; align-items:center; gap:18rpx; min-height:100rpx; border-bottom:2rpx solid var(--color-border); }
.editor-field:last-child { border-bottom:0; }
.editor-label { width:116rpx; flex-shrink:0; color:var(--color-text-weak); font-size:var(--font-size-normal); }
.editor-input { flex:1; color:var(--color-text); font-size:var(--font-size-normal); font-weight:700; }
.description-field { align-items:flex-start; padding:27rpx 0; }
.editor-textarea { flex:1; height:235rpx; color:var(--color-text); font-size:var(--font-size-normal); font-weight:700; line-height:1.5; }
.form-error { display:block; padding:10rpx 0 18rpx 134rpx; color:var(--color-status-cancelled); font-size:var(--font-size-small); }
.editor-dock { position:fixed; left:0; right:0; bottom:0; z-index:10; padding:20rpx 32rpx calc(22rpx + env(safe-area-inset-bottom)); background:var(--color-surface); border-top:2rpx solid var(--color-border); }
.editor-dock button { width:100%; margin:0; }
.editor-dock .poster-button { margin-top:15rpx; }
.poster-paper { min-height:470rpx; display:flex; flex-direction:column; box-sizing:border-box; padding:35rpx; border-radius:30rpx; background:var(--color-brand); color:var(--color-surface); }
.poster-brand { display:flex; align-items:center; gap:12rpx; font-size:var(--font-size-small); font-weight:650; }
.poster-brand image { width:62rpx; height:62rpx; }
.poster-course { margin-top:76rpx; font-size:var(--font-size-h1); font-weight:760; line-height:1.3; }
.poster-description { margin-top:17rpx; font-size:var(--font-size-normal); line-height:1.5; opacity:.9; }
.poster-footer { margin-top:auto; padding-top:52rpx; font-size:var(--font-size-small); opacity:.78; }
.share-button { width:100%; margin-top:25rpx; }
