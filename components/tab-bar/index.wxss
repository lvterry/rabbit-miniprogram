.tab-bar { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; height: 112rpx; padding-bottom: env(safe-area-inset-bottom); display: flex; align-items: center; justify-content: space-around; background: var(--color-surface-translucent); border-top: 2rpx solid var(--color-border); box-shadow: var(--shadow-tab-bar); }
.tab-item { width: 33.33%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: var(--color-text-weak); font-size:var(--font-size-small); font-weight: 600; }
.tab-symbol { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; }
.tab-symbol image { width: 34rpx; height: 34rpx; }
.active { color: var(--color-brand); }
.active .tab-symbol { background: var(--color-brand-soft); }
