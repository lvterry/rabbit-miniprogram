page {
  --color-brand: #198d53;
  --color-text: #293c30;
  --color-text-weak: #8a9a90;
  --color-border: #e7eee8;
  --color-page-background: #f7faf6;
  --color-surface: #ffffff;
  --color-surface-muted: #f6faf6;
  --color-brand-soft: #e4f6eb;
  --color-status-cancelled: #aa7042;
  --color-status-cancelled-background: #fff0dc;
  --color-chart-secondary: #76c995;
  --color-chart-tertiary: #b7dfbf;
  --color-chart-quaternary: #e4c780;
  --color-overlay: rgba(19,39,26,.42);
  --color-surface-translucent: rgba(255,255,255,.97);
  --color-surface-highlight: rgba(255,255,255,.15);
  --font-size-small: 24rpx;
  --font-size-normal: 28rpx;
  --font-size-h2: 34rpx;
  --font-size-h1: 36rpx;
  --shadow-card: 0 10rpx 30rpx rgba(30,77,49,.035);
  --shadow-brand: 0 22rpx 36rpx rgba(25,141,83,.18);
  --shadow-button: 0 12rpx 30rpx rgba(25,141,83,.28);
  --shadow-sheet: 0 -10rpx 50rpx rgba(22,48,29,.14);
  --shadow-dock: 0 -12rpx 34rpx rgba(23,70,45,.04);
  --shadow-tab-bar: 0 -10rpx 34rpx rgba(23,70,45,.035);
  background: var(--color-page-background);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--font-size-normal);
}

button::after { border: none; }
button.primary-button,
button.secondary-button,
button.plain-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
  line-height: 1.2;
}

.page-shell { min-height: 100vh; box-sizing: border-box; padding: 28rpx 32rpx 186rpx; }
.section-title { font-size: var(--font-size-h2); font-weight: 700; letter-spacing: .3rpx; }
.muted { color: var(--color-text-weak); }
.eyebrow { color: var(--color-text-weak); font-size: var(--font-size-small); font-weight: 600; letter-spacing: 3rpx; }
.card { background: var(--color-surface); border: 2rpx solid var(--color-border); border-radius: 32rpx; box-shadow: var(--shadow-card); }
.primary-button { background: var(--color-brand); color: var(--color-surface); border-radius: 22rpx; font-size: var(--font-size-normal); font-weight: 650; height: 88rpx; }
.secondary-button { background: var(--color-surface); color: var(--color-brand); border: 2rpx solid var(--color-border); border-radius: 22rpx; font-size: var(--font-size-normal); font-weight: 650; height: 88rpx; }
.plain-button { background: transparent; color: var(--color-brand); font-size: var(--font-size-small); height: 72rpx; }
